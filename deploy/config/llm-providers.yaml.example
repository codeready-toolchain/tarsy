# TARSy LLM Provider Configurations
# Copy this file to llm-providers.yaml and customize for your environment
#
# cp llm-providers.yaml.example llm-providers.yaml
#
# IMPORTANT: API keys should be configured via environment variables
# - Define actual API key values in your .env file
# - Use {{.VAR_NAME}} syntax to reference environment variables (Go template syntax)
# - Built-in providers can be overridden by defining same name

# =============================================================================
# GOOGLE / GEMINI PROVIDERS
# =============================================================================

llm_providers:
  # Fast model for quick responses
  gemini-2.5-flash:
    type: google
    model: gemini-2.5-flash
    api_key_env: GOOGLE_API_KEY
    native_tools:
      google_search: true
      code_execution: false
      url_context: true

  # Pro model for complex reasoning
  gemini-2.5-pro:
    type: google
    model: gemini-2.5-pro
    api_key_env: GOOGLE_API_KEY
    native_tools:
      google_search: true
      code_execution: false
      url_context: true

  # Next-gen model
  gemini-3.1-pro:
    type: google
    model: gemini-3.1-pro-preview
    api_key_env: GOOGLE_API_KEY
    native_tools:
      google_search: true
      code_execution: false
      url_context: true

  # Example: Google via OpenAI-compatible proxy
  openai-gemini-proxy:
    type: openai
    model: gemini-2.5-pro
    api_key_env: OPENAI_API_KEY
    base_url: https://gemini-proxy.example.com/v1beta/openai

# =============================================================================
# OPENAI PROVIDERS
# =============================================================================

  # GPT-5.2 for advanced reasoning (default)
  gpt-5.2:
    type: openai
    model: gpt-5.2
    api_key_env: OPENAI_API_KEY

  # o4-mini for fast reasoning
  o4-mini:
    type: openai
    model: o4-mini
    api_key_env: OPENAI_API_KEY

  # GPT-5 for general use
  gpt-5:
    type: openai
    model: gpt-5
    api_key_env: OPENAI_API_KEY

  # o3 for reasoning (legacy)
  o3:
    type: openai
    model: o3
    api_key_env: OPENAI_API_KEY

# =============================================================================
# ANTHROPIC / CLAUDE PROVIDERS
# =============================================================================

  # Claude Sonnet 5 for balanced performance (default)
  claude-sonnet-5:
    type: anthropic
    model: claude-sonnet-5
    api_key_env: ANTHROPIC_API_KEY

  # Claude Sonnet 4.6 (previous generation, pinned)
  claude-sonnet-4-6:
    type: anthropic
    model: claude-sonnet-4-6-20260217
    api_key_env: ANTHROPIC_API_KEY

  # Claude Opus 5 for maximum capability
  claude-opus:
    type: anthropic
    model: claude-opus-5
    api_key_env: ANTHROPIC_API_KEY

  # Claude Sonnet 4 for cost efficiency
  claude-sonnet-4:
    type: anthropic
    model: claude-sonnet-4-20250514
    api_key_env: ANTHROPIC_API_KEY

  # Claude Haiku for speed
  claude-haiku:
    type: anthropic
    model: claude-haiku-4-20250514
    api_key_env: ANTHROPIC_API_KEY

# =============================================================================
# X.AI / GROK PROVIDERS
# =============================================================================

  # Grok 4 for X.AI
  grok-4:
    type: xai
    model: grok-4
    api_key_env: XAI_API_KEY

# =============================================================================
# VERTEX AI PROVIDERS (GCP)
# =============================================================================

  # Claude Sonnet 5 on Vertex AI
  vertexai-claude-sonnet:
    type: vertexai
    model: claude-sonnet-5
    project_env: GCP_PROJECT
    location_env: GCP_LOCATION

  # Claude Opus 5 on Vertex AI
  vertexai-claude-opus:
    type: vertexai
    model: claude-opus-5
    project_env: GCP_PROJECT
    location_env: GCP_LOCATION

  # Gemini on Vertex AI
  vertexai-gemini-pro:
    type: vertexai
    model: gemini-2.5-pro
    project_env: GCP_PROJECT
    location_env: GCP_LOCATION

# =============================================================================
# CUSTOM / ENTERPRISE PROVIDERS
# =============================================================================

  # Example: Custom OpenAI-compatible endpoint
  custom-llm:
    type: openai
    model: custom-model
    api_key_env: CUSTOM_API_KEY
    base_url: https://llm.company.com/v1

  # Example: Azure OpenAI
  azure-o4-mini:
    type: openai
    model: o4-mini
    api_key_env: AZURE_OPENAI_KEY
    base_url: https://your-resource.openai.azure.com/openai/deployments/your-deployment
